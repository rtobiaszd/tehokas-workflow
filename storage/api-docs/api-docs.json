    "paths": {
        "/api/webhooks/workflows": {
            "post": {
                "tags": [
                    "Webhooks"
                ],
                "summary": "Receives workflow events",
                "operationId": "c0af48e42fa7f7a2c4ba22477007b98b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "event",
                                    "data"
                                ],
                                "properties": {
                                    "event": {
                                        "type": "string",
                                        "example": "project.status_changed"
                                    },
                                    "data": {
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Queued"
                    },
                    "422": {
                        "description": "Tenant not resolved"
                    }
                }
            }
        },
        "/swagger-ping": {
            "get": {
                "summary": "Swagger ping test",
